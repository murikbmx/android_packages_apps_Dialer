<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipChildren="false"
  android:clipToPadding="false">

  <TextView
    android:id="@+id/slide_hint_text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="@dimen/slide_hint_margin_bottom"
    android:accessibilityLiveRegion="polite"
    android:alpha="0"
    android:gravity="center"
    android:textAppearance="@style/Dialer.Incall.TextAppearance"
    android:textSize="14sp"/>

  <FrameLayout
    android:id="@+id/slide_track"
    android:layout_width="match_parent"
    android:layout_height="@dimen/slide_track_height"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/slide_track_margin_horizontal"
    android:layout_marginEnd="@dimen/slide_track_margin_horizontal"
    android:layout_marginBottom="@dimen/slide_track_margin_bottom"
    android:background="@drawable/slide_track_background"
    android:clipChildren="false">

    <View
      android:id="@+id/slide_decline_glow"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:alpha="0"
      android:background="@drawable/slide_decline_glow"/>

    <View
      android:id="@+id/slide_answer_glow"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:alpha="0"
      android:background="@drawable/slide_answer_glow"/>

    <TextView
      android:id="@+id/slide_decline_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="start|center_vertical"
      android:layout_marginStart="28dp"
      android:importantForAccessibility="no"
      android:text="@string/call_incoming_decline"
      android:textAppearance="@style/Dialer.Incall.TextAppearance"
      android:textColor="?android:attr/textColorPrimary"
      android:textSize="16sp"/>

    <TextView
      android:id="@+id/slide_answer_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="end|center_vertical"
      android:layout_marginEnd="28dp"
      android:importantForAccessibility="no"
      android:text="@string/call_incoming_answer"
      android:textAppearance="@style/Dialer.Incall.TextAppearance"
      android:textColor="?android:attr/textColorPrimary"
      android:textSize="16sp"/>

    <FrameLayout
      android:id="@+id/slide_thumb"
      android:layout_width="@dimen/slide_thumb_width"
      android:layout_height="@dimen/slide_thumb_height"
      android:layout_gravity="center"
      android:background="@drawable/slide_thumb_background"
      android:contentDescription="@string/a11y_call_incoming_answer_description"
      android:elevation="4dp">

      <ImageView
        android:id="@+id/slide_thumb_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/quantum_ic_call_vd_theme_24"
        android:tint="@color/slide_thumb_icon_color"/>
    </FrameLayout>
  </FrameLayout>
</FrameLayout>
