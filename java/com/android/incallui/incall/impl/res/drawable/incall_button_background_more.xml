<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:drawable="@drawable/incall_button_background"/>

  <!-- This adds a little dot to indicate that the button will pop up a menu. -->
  <item
    android:width="6dp"
    android:height="6dp"
    android:gravity="end|top"
    android:end="12dp"
    android:top="12dp">
    <shape android:shape="oval">
      <solid android:color="@color/incall_button_icon"/>
    </shape>
  </item>
</layer-list>
